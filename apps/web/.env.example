# Copier en .env.local (jamais committé). Sur Vercel : Settings > Environment Variables, puis redéployer sans cache.

# Supabase (public : URL + clé anon uniquement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé publique ed25519 pour vérifier la licence hors ligne
NEXT_PUBLIC_LICENSE_PUBLIC_KEY=

# Lien de paiement Wave Business
NEXT_PUBLIC_WAVE_PAYMENT_URL=

# Numéro WhatsApp support (format international, sans +)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Secrets Supabase (Edge Function activation) : `supabase secrets set`, JAMAIS dans le repo ---
# LICENSE_PRIVATE_KEY, APP_ORIGINS ; SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis par Supabase.

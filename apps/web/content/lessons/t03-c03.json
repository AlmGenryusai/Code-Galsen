{
  "id": "t03-c03",
  "theme": "t03",
  "sheets": [
    {
      "id": "t03-c03-f01",
      "title": "Écoles, hôpitaux, lieux de culte",
      "blocks": [
        {
          "type": "text",
          "text": "Autour de ces lieux, la limite est de 30 km/h : il y a des enfants, des malades, des fidèles."
        },
        {
          "type": "heading",
          "text": "Ce que je fais"
        },
        {
          "type": "list",
          "items": [
            "Je ralentis dès que je vois le panneau ou le bâtiment.",
            "Je regarde les entrées et les sorties.",
            "Je ne dépasse pas un véhicule arrêté devant l'entrée."
          ]
        },
        {
          "type": "heading",
          "text": "Aire piétonne"
        },
        {
          "type": "text",
          "text": "Dans une aire piétonne, les piétons sont prioritaires. Les véhicules autorisés roulent à l'allure du pas."
        },
        {
          "type": "heading",
          "text": "Panneaux à reconnaître"
        },
        {
          "type": "signs",
          "items": [
            {
              "media": {
                "kind": "sign",
                "src": "a13a",
                "alt": "Endroit fréquenté par des enfants",
                "credit": "Code Galsen"
              },
              "label": "Endroit fréquenté par des enfants"
            }
          ]
        },
        {
          "type": "memo",
          "text": "École, hôpital, mosquée, église : 30 km/h."
        },
        { "type": "image", "media": {"kind": "photo", "src": "p16.webp", "alt": "Ralentisseur sur la chaussée", "credit": "Андрей Романенко, CC BY-SA 4.0, via Wikimedia Commons"}, "caption": "Un ralentisseur : je ralentis avant, pas dessus." }
      ]
    },
    {
      "id": "t03-c03-f02",
      "title": "Passage à niveau",
      "blocks": [
        {
          "type": "text",
          "text": "Le train a toujours la priorité."
        },
        {
          "type": "heading",
          "text": "Avec barrières"
        },
        {
          "type": "text",
          "text": "J'obéis au garde et je n'empêche pas la fermeture des barrières."
        },
        {
          "type": "heading",
          "text": "Sans barrière"
        },
        {
          "type": "text",
          "text": "Je ne m'engage qu'après m'être assuré qu'aucun train n'approche et que je peux traverser en sécurité."
        },
        {
          "type": "heading",
          "text": "Si un train arrive"
        },
        {
          "type": "text",
          "text": "Je dégage immédiatement la voie ferrée. Il est interdit de stationner sur un passage à niveau, et de dépasser aux passages à niveau non gardés."
        },
        {
          "type": "heading",
          "text": "Panneaux à reconnaître"
        },
        {
          "type": "signs",
          "items": [
            {
              "media": {
                "kind": "sign",
                "src": "a7",
                "alt": "Passage à niveau avec barrières",
                "credit": "Code Galsen"
              },
              "label": "Passage à niveau avec barrières"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a8",
                "alt": "Passage à niveau sans barrières",
                "credit": "Code Galsen"
              },
              "label": "Passage à niveau sans barrières"
            }
          ]
        },
        {
          "type": "attention",
          "text": "Je ne contourne jamais une barrière."
        },
        {
          "type": "memo",
          "text": "Pas de passage si je ne suis pas sûr."
        }
      ]
    },
    {
      "id": "t03-c03-f03",
      "title": "Virages, descentes, routes étroites",
      "blocks": [
        {
          "type": "text",
          "text": "Certains endroits demandent de ralentir avant d'y être."
        },
        {
          "type": "heading",
          "text": "Je ralentis dans"
        },
        {
          "type": "list",
          "items": [
            "les virages et les descentes rapides",
            "l'approche des sommets de côte",
            "les routes étroites, encombrées ou bordées d'habitations",
            "les ralentisseurs de type dos d'âne et les traversées de villages"
          ]
        },
        {
          "type": "text",
          "text": "Près d'un marché ou d'un arrêt de car, des piétons surgissent sans regarder."
        },
        {
          "type": "heading",
          "text": "Panneaux à reconnaître"
        },
        {
          "type": "signs",
          "items": [
            {
              "media": {
                "kind": "sign",
                "src": "a1a",
                "alt": "Virage à droite",
                "credit": "Code Galsen"
              },
              "label": "Virage à droite"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a1b",
                "alt": "Virage à gauche",
                "credit": "Code Galsen"
              },
              "label": "Virage à gauche"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a1c",
                "alt": "Succession de virages, le premier à droite",
                "credit": "Code Galsen"
              },
              "label": "Succession de virages, le premier à droite"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a1d",
                "alt": "Succession de virages, le premier à gauche",
                "credit": "Code Galsen"
              },
              "label": "Succession de virages, le premier à gauche"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a2a",
                "alt": "Cassis ou dos d'âne",
                "credit": "Code Galsen"
              },
              "label": "Cassis ou dos d'âne"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a2b",
                "alt": "Ralentisseur",
                "credit": "Code Galsen"
              },
              "label": "Ralentisseur"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a3",
                "alt": "Chaussée rétrécie",
                "credit": "Code Galsen"
              },
              "label": "Chaussée rétrécie"
            },
            {
              "media": {
                "kind": "sign",
                "src": "a16",
                "alt": "Descente dangereuse",
                "credit": "Code Galsen"
              },
              "label": "Descente dangereuse"
            }
          ]
        },
        {
          "type": "attention",
          "text": "Je ralentis avant le danger, pas dedans."
        },
        {
          "type": "memo",
          "text": "Virage, village, marché : je lève le pied."
        },
        { "type": "image", "media": {"kind": "photo", "src": "p25.webp", "alt": "Camion de livraison sur une route étroite bordée de haies", "credit": "Eric Jones, CC BY-SA 2.0, via Wikimedia Commons"}, "caption": "Route étroite : je ralentis et je suis prêt à m'arrêter pour croiser." }
      ]
    }
  ],

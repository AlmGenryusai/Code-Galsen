      "title": "Ceinture et airbag",
      "blocks": [
        {
          "type": "text",
          "text": "La ceinture sauve des vies, même à faible vitesse."
        },
        {
          "type": "heading",
          "text": "À retenir"
        },
        {
          "type": "list",
          "items": [
            "Je l'attache à chaque trajet, même court.",
            "Je conseille à mes passagers de s'attacher, aux places équipées d'une ceinture.",
            "L'airbag complète la ceinture, il ne la remplace pas."
          ]
        },
        {
          "type": "attention",
          "text": "Un passager non attaché peut devenir un projectile et blesser les autres."
        },
        {
          "type": "memo",
          "text": "Ceinture d'abord, airbag en plus."
        }
      ]
    },
    {
      "id": "t09-c01-f02",
      "title": "Freiner avec l'ABS",
      "blocks": [
        {
          "type": "text",
          "text": "L'ABS empêche les roues de bloquer au freinage."
        },
        {
          "type": "heading",
          "text": "Au freinage d'urgence"
        },
        {
          "type": "list",
          "items": [
            "J'appuie à fond sur la pédale et je la maintiens.",
            "Je garde le volant pour contrôler la direction.",
            "Je ne pompe pas."
          ]
        },
        {
          "type": "memo",
          "text": "Appuyer à fond, rester appuyé."
        }
      ]
    }

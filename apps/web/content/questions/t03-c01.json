[
  {
    "id": "t03-c01-0001",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Il y a du brouillard. Je roule avec :",
        "options": [
          {
            "id": "A",
            "text": "aucun feu"
          },
          {
            "id": "B",
            "text": "les feux de croisement"
          },
          {
            "id": "C",
            "text": "les feux de route"
          },
          {
            "id": "D",
            "text": "les feux de détresse"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Par temps de brouillard, on allume les feux de croisement ou de route, même de jour. Les feux de croisement éblouissent moins dans la brume.",
    "common_mistake": "Rouler sans feux de jour.",
    "legal_ref": "Décret 2004-13, art. 82 ; loi 2022-04, L.62",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },
  {
    "id": "t03-c01-0002",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Dans le brouillard, je règle ma vitesse :",
        "options": [
          {
            "id": "A",
            "text": "sur la limite autorisée"
          },
          {
            "id": "B",
            "text": "pour pouvoir m'arrêter dans ce que je vois"
          },
          {
            "id": "C",
            "text": "sur celle du véhicule devant"
          },
          {
            "id": "D",
            "text": "pour sortir du brouillard plus vite"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "On doit réduire sa vitesse quand la visibilité est insuffisante. La limite n'est pas un objectif.",
    "common_mistake": "Rouler vite pour traverser plus vite.",
    "legal_ref": "Décret 2004-13, art. 13",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },
  {
    "id": "t03-c01-0003",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "En voiture, je vois à moins de 50 mètres. Ma vitesse maximale est :",
        "options": [
          {
            "id": "A",
            "text": "50 km/h"
          },
          {
            "id": "B",
            "text": "70 km/h"
          },
          {
            "id": "C",
            "text": "90 km/h"
          },
          {
            "id": "D",
            "text": "30 km/h"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Quand la visibilité est inférieure à 50 m, la limite tombe à 50 km/h pour une voiture, sur toute route.",
    "common_mistake": "Garder la vitesse du beau temps.",
    "legal_ref": "loi 2022-04, L.58",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },
  {
    "id": "t03-c01-0004",
    "theme": "t03",
    "chapter": "t03-c01",
    "media": {

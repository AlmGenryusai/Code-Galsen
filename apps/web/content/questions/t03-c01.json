        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Sur sol mouillé, la distance de freinage augmente. Freiner tôt et doucement évite le dérapage.",
    "common_mistake": "Freiner brutalement sur route mouillée.",
    "legal_ref": null,
    "legal_status": "not_regulatory",
    "status": "draft"
  },
  {
    "id": "t03-c01-0007",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [

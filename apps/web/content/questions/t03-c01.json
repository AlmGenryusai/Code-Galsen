[
  {
    "id": "t03-c01-0001",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Il y a du brouillard. Je roule avec :",
        "options": [
          {
            "id": "A",
            "text": "aucun feu"
          },
          {
            "id": "B",
            "text": "les feux de croisement"
          },
          {
            "id": "C",
            "text": "les feux de route"
          },
          {
            "id": "D",
            "text": "les feux de détresse"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Par temps de brouillard, on allume les feux de croisement ou de route, même de jour. Les feux de croisement éblouissent moins dans la brume.",
    "common_mistake": "Rouler sans feux de jour.",
    "legal_ref": "Décret 2004-13, art. 82",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t03-c01-0002",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Dans le brouillard, je règle ma vitesse :",
        "options": [
          {
            "id": "A",
            "text": "à la limite autorisée"
          },
          {
            "id": "B",
            "text": "pour pouvoir m'arrêter dans ce que je vois"
          },
          {
            "id": "C",
            "text": "comme d'habitude"
          },
          {
            "id": "D",
            "text": "plus vite pour sortir du brouillard"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "On doit réduire sa vitesse quand la visibilité est insuffisante. La limite n'est pas un objectif.",
    "common_mistake": "Rouler vite pour traverser plus vite.",
    "legal_ref": "Décret 2004-13, art. 13",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t03-c01-0003",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Je vois à moins de 50 mètres. Ma vitesse maximale est :",
        "options": [
          {
            "id": "A",
            "text": "50 km/h"
          },
          {
            "id": "B",
            "text": "70 km/h"
          },
          {
            "id": "C",
            "text": "90 km/h"
          },
          {
            "id": "D",
            "text": "la même qu'avant"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Quand la visibilité est inférieure à 50 m, la limite tombe à 50 km/h sur toute route.",
    "common_mistake": "Garder la vitesse du beau temps.",
    "legal_ref": "loi 2022-04, L.58",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t03-c01-0004",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "Sur la route, de la poussière ou du sable réduit ma vue. Je :",
        "options": [
          {
            "id": "A",
            "text": "accélère"
          },
          {
            "id": "B",
            "text": "ralentis et reste prudent"
          },
          {
            "id": "C",
            "text": "klaxonne tout le temps"
          },
          {
            "id": "D",
            "text": "m'arrête au milieu de la route"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Poussière, sable, fumée ou forte pluie imposent une vitesse réduite. Un klaxon ne fait pas voir plus loin.",
    "common_mistake": "Accélérer pour s'en sortir.",
    "legal_ref": "Décret 2004-13, art. 13",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t03-c01-0005",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {
        "text": "La nuit, je suis de près un autre véhicule. Je mets :",
        "options": [
          {
            "id": "A",
            "text": "les feux de route"
          },
          {
            "id": "B",
            "text": "les feux de croisement"
          },
          {
            "id": "C",
            "text": "les feux de détresse"
          },
          {
            "id": "D",
            "text": "aucun feu"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Les feux de croisement remplacent les feux de route quand on suit de près ou quand on croise, pour ne pas éblouir.",
    "common_mistake": "Rester en feux de route derrière un véhicule.",
    "legal_ref": "Décret 2004-13, art. 82",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t03-c01-0006",
    "theme": "t03",
    "chapter": "t03-c01",
    "parts": [
      {

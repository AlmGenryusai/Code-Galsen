  {
    "id": "t03-c01-0001",
    "theme": "t03",
    "chapter": "t03-c01",
    "context": "Il y a du brouillard.",
    "media": {
      "kind": "photo",
      "src": "s06.webp",
      "alt": "Phares d'un véhicule dans un épais brouillard",
      "credit": "Tupungato, CC BY 3.0, Wikimedia Commons"
    },
    "parts": [
      {
        "text": "Je roule avec :",
        "options": [
          {
            "id": "A",
            "text": "aucun feu"
          },
          {
            "id": "B",
            "text": "les feux de croisement"
          },
          {
            "id": "C",
            "text": "les feux de route, toujours"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Par temps de brouillard, on allume les feux de croisement ou de route, même de jour. Les feux de croisement éblouissent moins dans la brume.",
    "common_mistake": "Rouler sans feux de jour.",
    "legal_ref": "Décret 2004-13, art. 82 ; loi 2022-04, L.62",
    "legal_status": "confirmed",
    "status": "reviewed",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },

      {
        "text": "Un chargement ne doit :",
        "options": [
          {
            "id": "A",
            "text": "causer ni dommage ni danger"
          },
          {
            "id": "B",
            "text": "tomber sur la route en roulant"
          },
          {
            "id": "C",
            "text": "dépasser du véhicule sans être amarré"
          },
          {
            "id": "D",
            "text": "traîner sur le sol derrière moi"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Toute précaution doit être prise pour que le chargement ne puisse blesser ou gêner personne.",
    "common_mistake": "Penser qu'un chargement tient tout seul.",
    "legal_ref": "loi 2022-04, L.54",
    "legal_status": "confirmed",
    "status": "published",
    "review": {

      {
        "text": "Un chargement ne doit :",
        "options": [
          {
            "id": "A",
            "text": "causer ni dommage ni danger"
          },
          {
            "id": "B",
            "text": "tomber sur la route"
          },
          {
            "id": "C",
            "text": "dépasser sans être amarré"
          },
          {
            "id": "D",
            "text": "traîner sur le sol"
          }

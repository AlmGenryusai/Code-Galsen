          {
            "id": "A",
            "text": "les laisser à l'air libre"
          },
          {
            "id": "B",
            "text": "les amarrer sous une bâche étanche"
          },
          {
            "id": "C",
            "text": "rouler très vite pour limiter la poussière"
          },
          {
            "id": "D",
            "text": "les mouiller avant de partir"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Les matériaux pulvérulents doivent être solidement amarrés sous une bâche étanche pour ne pas s'envoler.",
    "common_mistake": "Rouler avec des matériaux pulvérulents non couverts.",
    "legal_ref": "loi 2022-04, L.54",
    "legal_status": "confirmed",

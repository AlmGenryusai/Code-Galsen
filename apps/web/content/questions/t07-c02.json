  {
    "id": "t07-c02-0004",
    "theme": "t07",
    "chapter": "t07-c02",
    "parts": [
      {
        "text": "J'ouvre ma portière pour monter dans ma voiture. Je m'assure d'abord :",
        "options": [
          {
            "id": "A",
            "text": "que l'ouverture est sans danger"
          },
          {
            "id": "B",
            "text": "que mon téléphone est chargé"
          },
          {
            "id": "C",
            "text": "que la radio fonctionne"
          },
          {
            "id": "D",
            "text": "que tout le monde est assis"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "On s'assure avant d'ouvrir la portière, pour entrer comme pour sortir : des véhicules, des motos, des piétons peuvent passer.",
    "common_mistake": "Ouvrir sans regarder la circulation.",
    "legal_ref": "Décret 2004-13, art. 35",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },

    "theme": "t07",
    "chapter": "t07-c02",
    "parts": [
      {
        "text": "Quand je me gare au bord de la route, je fais descendre mes passagers :",
        "options": [
          {
            "id": "A",
            "text": "côté route"
          },
          {
            "id": "B",
            "text": "côté trottoir ou accotement"
          },
          {
            "id": "C",
            "text": "au milieu de la chaussée"
          },
          {
            "id": "D",
            "text": "pendant que je roule encore"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Le côté du trottoir ou de l'accotement est plus sûr : les passagers ne descendent pas dans la circulation.",
    "common_mistake": "Faire descendre côté route.",
    "legal_ref": null,
    "legal_status": "not_regulatory",
    "status": "published",
    "review": {

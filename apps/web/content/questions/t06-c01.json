          {
            "id": "B",
            "text": "attends les secours sans rien faire"
          },
          {
            "id": "C",
            "text": "lui donne à boire"
          },
          {
            "id": "D",
            "text": "la fais marcher"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Une pression forte et continue sur la plaie arrête la plupart des saignements, en attendant les secours.",

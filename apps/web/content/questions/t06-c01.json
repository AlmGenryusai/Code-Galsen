  {
    "id": "t06-c01-0002",
    "theme": "t06",
    "chapter": "t06-c01",
    "parts": [
      {
        "text": "Mon véhicule a causé un accident. Je :",
        "options": [
          {
            "id": "A",
            "text": "continue ma route"
          },
          {
            "id": "B",
            "text": "m'arrête et reste sur place"
          },
          {
            "id": "C",
            "text": "cherche un ami pour m'aider"
          },
          {
            "id": "D",
            "text": "ralentis, regarde, puis repars"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Le conducteur qui sait que son véhicule a causé ou occasionné un accident et ne s'arrête pas commet un délit. On s'arrête.",
    "common_mistake": "Fuir par peur.",
    "legal_ref": "loi 2022-04, L.82",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },
  {

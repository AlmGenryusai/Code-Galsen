    "chapter": "t01-c01",
    "parts": [
      {
        "text": "Que signifie un feu orange fixe ?",
        "options": [
          {
            "id": "A",
            "text": "Accélérer pour passer avant le rouge"
          },
          {
            "id": "B",
            "text": "Freiner si possible, sinon franchir prudemment"
          },
          {
            "id": "C",
            "text": "Même signification qu'un feu rouge"
          },
          {
            "id": "D",
            "text": "Priorité aux piétons uniquement"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Le feu orange annonce le passage au rouge. Freinez si vous le pouvez en toute sécurité ; sinon, franchissez prudemment l'intersection.",
    "legal_ref": "Décret 2004-13, annexe P7",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-10-28",
      "juriste": "2026-10-28"
    }
  },

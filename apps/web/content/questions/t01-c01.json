    "parts": [
      {
        "text": "Un panneau rond, fond blanc, bordé de rouge, signifie :",
        "options": [
          {
            "id": "A",
            "text": "une obligation"
          },
          {
            "id": "B",
            "text": "un danger"
          },
          {
            "id": "C",
            "text": "une interdiction"
          },
          {
            "id": "D",
            "text": "une simple indication"
          }
        ],
        "correct": [
          "C"
        ]
      }
    ],
    "explanation": "Les panneaux d'interdiction sont ronds, à fond blanc bordé de rouge. Seul le sens interdit a un fond rouge entier. Les obligations sont sur fond bleu.",
    "common_mistake": "Croire que tous les panneaux à fond rouge sont des interdictions.",
    "legal_ref": "Décret 2004-13, annexe P4",
    "legal_status": "confirmed",
    "status": "published",
    "review": {

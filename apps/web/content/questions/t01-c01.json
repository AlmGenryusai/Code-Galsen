          {
            "id": "A",
            "text": "Sur toute route en dehors des agglomérations"
          },
          {
            "id": "B",
            "text": "Lorsqu'une ligne continue sépare les voies"
          },
          {
            "id": "C",
            "text": "De nuit uniquement"
          },
          {
            "id": "D",
            "text": "Uniquement sur les routes nationales"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "La ligne continue au centre de la chaussée interdit formellement tout dépassement. Seule la ligne discontinue autorise le franchissement.",
    "legal_ref": "Décret 2004-13, art. 4 ; loi 2022-04, L.102 3°",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-10-30",
      "juriste": "2026-10-30"
    }
  },
  {

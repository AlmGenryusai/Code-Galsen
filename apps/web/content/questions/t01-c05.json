  {
    "id": "t01-c05-0007",
    "theme": "t01",
    "chapter": "t01-c05",
    "context": "Un véhicule en panne bloque ma voie. Des voitures arrivent en face.",
    "parts": [
      {
        "text": "Je :",
        "options": [
          {
            "id": "A",
            "text": "passe, je suis plus près"
          },
          {
            "id": "B",
            "text": "cède à ceux d'en face"
          },
          {
            "id": "C",
            "text": "klaxonne et fonce"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Quand un obstacle ne peut pas être contourné par la droite, celui dont la voie est bloquée cède le passage aux véhicules venant en sens inverse.",
    "common_mistake": "Forcer le passage.",
    "legal_ref": "Décret 2004-13, art. 23",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",

  {
    "id": "t01-c05-0006",
    "theme": "t01",
    "chapter": "t01-c05",
    "context": "Je veux dépasser.",
    "media": {
      "kind": "photo",
      "src": "n-S02-4.webp",
      "alt": "Route vue depuis l'habitacle, véhicule devant",
      "credit": "Source inconnue (Google Images)"
    },
    "parts": [
      {
        "text": "Je ne dépasse pas :",
        "options": [
          {
            "id": "A",
            "text": "dans un virage sans visibilité"
          },
          {
            "id": "B",
            "text": "près d'un sommet de côte"
          },
          {
            "id": "C",
            "text": "sur une ligne droite dégagée"
          },
          {
            "id": "D",
            "text": "à une intersection (sauf prioritaire)"
          }
        ],
        "correct": [
          "A",
          "B",
          "D"
        ]
      }
    ],
    "explanation": "Le dépassement est interdit sans visibilité (virage, sommet de côte), aux passages à niveau non gardés et aux intersections.",
    "common_mistake": "Dépasser à l'approche d'une côte.",
    "legal_ref": "Décret 2004-13, art. 21 (al.1 à 3)",
    "legal_status": "confirmed",
    "status": "published",
    "review": {

[
  {
    "id": "t01-c05-0001",
    "theme": "t01",
    "chapter": "t01-c05",
    "context": "Je croise un véhicule qui vient en face.",
    "media": {
      "kind": "photo",
      "src": "q-t01-c05-0001.webp",
      "alt": "Car qui arrive en face sur une route à double sens",
      "credit": "WILLAV-FR, CC BY-SA 4.0, Wikimedia Commons"
    },
    "parts": [
      {
        "text": "Je me place :",
        "options": [
          {
            "id": "A",
            "text": "au milieu de la route"
          },
          {
            "id": "B",
            "text": "à droite de ma voie"
          },
          {
            "id": "C",
            "text": "à gauche de ma voie"
          }
        ],
        "correct": [
          "B"
        ]
      }
    ],
    "explanation": "Les croisements se font à droite. Chacun se serre sur sa droite pour laisser de la place.",
    "common_mistake": "Rouler au milieu en croisant.",
    "legal_ref": "Décret 2004-13, art. 15 à 17",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },
  {
    "id": "t01-c05-0002",
    "theme": "t01",
    "chapter": "t01-c05",
    "context": "Je vais dépasser.",
    "media": {
      "kind": "photo",
      "src": "q-t01-c05-0002.webp",
      "alt": "Dépassement d'un camion sur une route à double sens",
      "credit": "BrokenSphere, CC BY-SA 3.0, Wikimedia Commons"
    },
    "parts": [
      {
        "text": "Avant, je :",
        "options": [
          {
            "id": "A",
            "text": "m'assure d'avoir de la place"
          },
          {
            "id": "B",
            "text": "préviens de mon intention"
          },
          {
            "id": "C",
            "text": "regarde si on me dépasse"
          },
          {
            "id": "D",
            "text": "accélère à fond dès le départ"
          }
        ],
        "correct": [
          "A",
          "B",
          "C"
        ]
      }
    ],
    "explanation": "On dépasse à gauche, après avoir vérifié l'espace et la vue, et en prévenant (clignotant, appel de phares, avertisseur).",
    "common_mistake": "Dépasser sans prévenir.",
    "legal_ref": "Décret 2004-13, art. 18",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-11-03",
      "juriste": "2026-11-03"
    }
  },

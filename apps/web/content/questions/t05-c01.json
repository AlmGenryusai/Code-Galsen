  {
    "id": "t05-c01-0004",
    "theme": "t05",
    "chapter": "t05-c01",
    "parts": [
      {
        "text": "Un véhicule de transport de personnes ou de marchandises, hors véhicule neuf, doit passer la visite technique :",
        "options": [
          {
            "id": "A",
            "text": "avant sa mise en circulation"
          },
          {
            "id": "B",
            "text": "seulement après un accident"
          },
          {
            "id": "C",
            "text": "jamais"
          },
          {
            "id": "D",
            "text": "tous les dix ans"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Tout véhicule employé au transport de personnes ou de marchandises passe d'abord une visite technique, puis aux dates fixées. Les véhicules neufs n'y sont pas soumis (L.47).",
    "common_mistake": "Faire circuler un car sans visite.",
    "legal_ref": "loi 2022-04, L.47",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-10-28",
      "juriste": "2026-10-28"
    }
  },

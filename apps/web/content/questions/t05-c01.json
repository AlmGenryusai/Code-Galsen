    "chapter": "t05-c01",
    "parts": [
      {
        "text": "Après l'achat d'un véhicule mis en circulation pour la première fois, je déclare sa mise en circulation :",
        "options": [
          {
            "id": "A",
            "text": "dans un délai de 15 jours"
          },
          {
            "id": "B",
            "text": "dans un délai d'un an"
          },
          {
            "id": "C",
            "text": "dans un délai de 48 heures"
          },
          {
            "id": "D",
            "text": "seulement si on me le demande"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Le propriétaire doit adresser la déclaration de mise en circulation dans les quinze jours. Il reçoit un certificat d'immatriculation et d'aptitude technique.",
    "common_mistake": "Rouler des mois sans déclaration.",
    "legal_ref": "Décret 2004-13, art. 44 et 45",
    "legal_status": "confirmed",
    "status": "published",

    "chapter": "t05-c01",
    "parts": [
      {
        "text": "À la demande d'un agent, je dois présenter :",
        "options": [
          {
            "id": "A",
            "text": "mon permis de conduire"
          },
          {
            "id": "B",
            "text": "le certificat d'immatriculation du véhicule"
          },
          {
            "id": "C",
            "text": "l'attestation d'assurance"
          },
          {
            "id": "D",
            "text": "mon passeport"
          }
        ],
        "correct": [
          "A",
          "B",
          "C"
        ]
      }
    ],
    "explanation": "Permis, certificat d'immatriculation (avec la mention de visite technique) et, selon le cas, assurance ou autorisation de transport.",
    "common_mistake": "Penser que le permis suffit.",
    "legal_ref": "Décret 2004-13, art. 107",
    "legal_status": "pending",
    "status": "draft"
  },
  {
    "id": "t05-c01-0002",
    "theme": "t05",
    "chapter": "t05-c01",
    "parts": [
      {
        "text": "Après l'achat d'un véhicule mis en circulation pour la première fois, je déclare sa mise en circulation :",
        "options": [
          {
            "id": "A",
            "text": "dans un délai de 15 jours"
          },
          {
            "id": "B",
            "text": "dans un délai d'un an"
          },
          {
            "id": "C",
            "text": "jamais"
          },
          {
            "id": "D",
            "text": "seulement si on me le demande"
          }
        ],
        "correct": [
          "A"
        ]
      }
    ],
    "explanation": "Le propriétaire doit adresser la déclaration de mise en circulation dans les quinze jours. Il reçoit un certificat d'immatriculation et d'aptitude technique.",
    "common_mistake": "Rouler des mois sans déclaration.",
    "legal_ref": "Décret 2004-13, art. 44 et 45",
    "legal_status": "confirmed",
    "status": "published",
    "review": {
      "moniteur": "2026-10-28",
      "juriste": "2026-10-28"
    }
  },
